# ============================================================
# text2sql — Environment Configuration Example
# ============================================================
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.
# ============================================================


# --- Database (Required) ---
DB_DIALECT=mysql                # mysql | postgresql
DB_DRIVER=mysqlconnector        # mysqlconnector | psycopg2
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=3306                    # 3306 (MySQL) | 5432 (PostgreSQL)
DB_NAME=text2sql


# --- LLM (Required) ---
OPENAI_API_KEY=sk-...


# --- Observability (Optional) ---
LANGSMITH_TRACING=true          # true | false — set false to disable tracing
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=text2sql
